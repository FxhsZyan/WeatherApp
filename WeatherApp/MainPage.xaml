<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:WeatherApp.ViewModels"
             xmlns:converters="clr-namespace:WeatherApp.Converters"
             x:Class="WeatherApp.MainPage"
             BackgroundColor="Transparent">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:NullToBoolConverter x:Key="NullToBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.BindingContext>
        <viewmodels:MainViewModel />
    </ContentPage.BindingContext>

    <Grid RowDefinitions="Auto, Auto, *, Auto, Auto, Auto">

        <!-- Background Image -->
        <Image Source="weather_bg_day.png"
               Aspect="AspectFill"
               Grid.RowSpan="6" />

        <!-- Row 0: Header -->
        <VerticalStackLayout Grid.Row="0" Padding="20,20,20,5" Spacing="3">
            <Grid ColumnDefinitions="*, Auto">
                <Label Grid.Column="0"
                       Text="{Binding CityName}"
                       FontSize="26"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Start"
                       MaxLines="2"
                       LineBreakMode="WordWrap"/>
                <Button Grid.Column="1"
                        Text="♥"
                        FontSize="24"
                        TextColor="{Binding IsFavorite, Converter={StaticResource NullToBoolConverter}}"
                        BackgroundColor="Transparent"
                        Command="{Binding ToggleFavoriteCommand}"
                        VerticalOptions="Start"
                        WidthRequest="50"/>
            </Grid>
            <Label Text="{Binding CurrentDate, StringFormat='{0:D}'}"
                   FontSize="14"
                   TextColor="White"
                   HorizontalOptions="Start" />
        </VerticalStackLayout>

        <!-- Row 1: Search Bar -->
        <Frame Grid.Row="1"
               Margin="20,0"
               Padding="10"
               BackgroundColor="#80FFFFFF"
               CornerRadius="30"
               HasShadow="False">
            <Grid ColumnDefinitions="*, Auto">
                <Entry Grid.Column="0"
                       Placeholder="Search city..."
                       PlaceholderColor="#7A9EC5"
                       TextColor="#3A6EA5"
                       Text="{Binding SearchText}"
                       ReturnCommand="{Binding SearchCommand}"
                       BackgroundColor="Transparent"
                       VerticalOptions="Center" />
                <Button Grid.Column="1"
                        Text="🔍"
                        Command="{Binding SearchCommand}"
                        BackgroundColor="Transparent"
                        TextColor="#3A6EA5"
                        FontSize="18"
                        Padding="5" />
            </Grid>
        </Frame>

        <!-- Row 2: Current Weather -->
        <VerticalStackLayout Grid.Row="2" VerticalOptions="Center" Spacing="2">
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                       IsVisible="{Binding IsBusy}"
                       Color="White"
                       HorizontalOptions="Center" />
            <Image Source="{Binding CurrentIcon}"
           HeightRequest="90"
           WidthRequest="90"
           HorizontalOptions="Center" />
            <Label Text="{Binding CurrentTemp}"
           FontSize="55"
           FontAttributes="Bold"
           TextColor="#3A6EA5"
           HorizontalOptions="Center" />
            <Label Text="{Binding CurrentCondition}"
           FontSize="18"
           TextColor="#3A6EA5"
           HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- Row 3: Hourly Forecast Strip -->
        <Frame Grid.Row="3"
               Margin="20,10,20,0"
               Padding="10"
               BackgroundColor="#80FFFFFF"
               CornerRadius="20"
               HasShadow="False">
            <VerticalStackLayout Spacing="5">
                <Label Text="Today's Forecast"
                       FontSize="13"
                       FontAttributes="Bold"
                       TextColor="#1a1a2e"
                       Margin="5,0,0,0"/>
                <CollectionView ItemsSource="{Binding HourlyForecast}"
                                HeightRequest="90">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="5" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame Padding="8"
                                   CornerRadius="15"
                                   HasShadow="False"
                                   BackgroundColor="#60FFFFFF"
                                   WidthRequest="65">
                                <VerticalStackLayout Spacing="3" HorizontalOptions="Center">
                                    <Label Text="{Binding Time}"
                                           FontSize="11"
                                           TextColor="#1a1a2e"
                                           HorizontalOptions="Center"
                                           FontAttributes="Bold"/>
                                    <Image Source="{Binding Icon}"
                                           HeightRequest="28"
                                           WidthRequest="28"
                                           HorizontalOptions="Center"/>
                                    <Label Text="{Binding Temperature}"
                                           FontSize="13"
                                           TextColor="#3A6EA5"
                                           FontAttributes="Bold"
                                           HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </Frame>

        <!-- Row 4: 7-Day Forecast -->
        <Frame Grid.Row="4"
               Margin="20,10,20,0"
               Padding="10"
               BackgroundColor="#80FFFFFF"
               CornerRadius="20"
               HasShadow="False">
            <CollectionView ItemsSource="{Binding Forecast}" HeightRequest="160">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="*, Auto, Auto" Padding="10">
                            <Label Grid.Column="0"
                                   Text="{Binding Date}"
                                   VerticalOptions="Center"
                                   TextColor="#1a1a2e" />
                            <Image Grid.Column="1"
                                   Source="{Binding Icon}"
                                   HeightRequest="30"
                                   WidthRequest="30"
                                   Margin="10,0" />
                            <Label Grid.Column="2" VerticalOptions="Center">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding TempMax, StringFormat='{0}°'}"
                                              FontAttributes="Bold"
                                              TextColor="#1a1a2e" />
                                        <Span Text=" / " TextColor="#1a1a2e" />
                                        <Span Text="{Binding TempMin, StringFormat='{0}°'}"
                                              TextColor="#1a1a2e" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Frame>

        <!-- Row 5: View Details Button -->
        <Button Grid.Row="5"
                Text="View Details"
                Margin="20,10"
                BackgroundColor="#50FFFFFF"
                TextColor="#3A6EA5"
                FontAttributes="Bold"
                CornerRadius="20"
                Command="{Binding ViewDetailsCommand}" />

    </Grid>
</ContentPage>